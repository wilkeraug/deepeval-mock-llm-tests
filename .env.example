# Environment (local, test, stage/staging, prod/production)
CURRENT_ENV=test

# Server URLs per environment (same servers as the JS chatbot-test-project)
LOCAL_SERVER=http://localhost:8081
TEST_SERVER=https://test.mbshighway.com
STAGE_SERVER=https://stage.mbshighway.com
PROD_SERVER=https://mbshighway.com

# Optional override for any environment
SERVER_URL=

# Socket.IO path used by the chatbot server
SOCKET_IO_PATH=/hwapp/hwy-ai-server/socket/

# JWT configuration (must match server config — same secret as the JS project)
JWT_SECRET=replace-with-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=24h
JWT_ISSUER=
JWT_AUDIENCE=

# Test user configuration
TEST_USER_ID=replace-with-test-user-id
TEST_USER_NAME=Automation User
TEST_USER_EMAIL=automation@example.com
TEST_USER_NMLS=000000
TEST_USER_LR_ID=
TEST_APP_NAME=mbs-bot

# Staging user configuration
STAGE_USER_ID=replace-with-stage-user-id
STAGE_USER_NAME=Staging Automation User
STAGE_USER_EMAIL=staging-automation@example.com
STAGE_USER_NMLS=000000
STAGE_USER_LR_ID=
STAGE_APP_NAME=mbs-bot

# Production user configuration
PROD_USER_ID=replace-with-prod-user-id
PROD_USER_NAME=Production Automation User
PROD_USER_EMAIL=prod-automation@example.com
PROD_USER_NMLS=000000
PROD_USER_LR_ID=
PROD_APP_NAME=mbs-bot

# Test client configuration
TEST_CLIENT_NAME=Automation Client
LOCATION_SCENARIO=City, State, USA

# --- DeepEval / LLM judge configuration ---
# DeepEval's default metrics call an LLM judge via the OpenAI API.
# Set OPENAI_API_KEY, or configure deepeval to use Anthropic/another provider
# (see README.md "Judge model" section).
OPENAI_API_KEY=replace-with-openai-api-key

# Metric thresholds (0-1). Tune per suite as false positive/negative rates emerge.
DEEPEVAL_ANSWER_RELEVANCY_THRESHOLD=0.7
DEEPEVAL_FAITHFULNESS_THRESHOLD=0.7
DEEPEVAL_HALLUCINATION_THRESHOLD=0.5
