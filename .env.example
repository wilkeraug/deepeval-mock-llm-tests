# --- DeepEval / LLM judge configuration ---
# The chatbot responses are mocked; only the metric judge needs an API key.
# Confident AI dashboard access is optional and is configured with
# `deepeval login`, not in this file. Local tests do not need that login.
# Set OPENAI_API_KEY to use DeepEval's default OpenAI judge.
OPENAI_API_KEY=

# Or use Groq as the judge model instead of OpenAI.
# If GROQ_API_KEY is set, tests automatically use it via src/utils/groq_judge.py.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Metric thresholds (0-1). Tune per suite as false positive/negative rates emerge.
DEEPEVAL_ANSWER_RELEVANCY_THRESHOLD=0.7
DEEPEVAL_FAITHFULNESS_THRESHOLD=0.7
DEEPEVAL_HALLUCINATION_THRESHOLD=0.5
DEEPEVAL_GEVAL_THRESHOLD=0.7
